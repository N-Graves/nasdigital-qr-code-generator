{
  "name": "nasdigital-qr-code-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Make a QR code in the browser - SVG or PNG, including WiFi join codes. The text never leaves your device.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "demo": "npm run build && node scripts/serve.mjs"
  },
  "dependencies": {
    "@nasdigitaluk/withnate-tool-core": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "author": "Nathan Graves",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N-Graves/nasdigital-qr-code-generator.git"
  },
  "bugs": {
    "url": "https://github.com/N-Graves/nasdigital-qr-code-generator/issues"
  },
  "homepage": "https://github.com/N-Graves/nasdigital-qr-code-generator#readme",
  "keywords": [
    "qr",
    "qrcode",
    "wifi",
    "svg",
    "browser",
    "client-side",
    "nasdigital"
  ]
}
